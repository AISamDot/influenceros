# Influencer OS environment. Copy to .env.local only if you need overrides; never commit real values.
# On the Mac, provider keys live in the Keychain (`pnpm ios secrets set <name>`); env vars win when both exist.
# Any integration without a key runs on its deterministic fake.

# ── Database ──
# Unset = local PGlite under .data/pglite. Set = Postgres (Supabase), e.g. postgres://…:6543/postgres
DATABASE_URL=
DATABASE_POOL_MAX=
PGLITE_DIR=

# ── Providers (secret name in the Keychain in brackets) ──
ANTHROPIC_API_KEY=              # [anthropic.api_key] Claude Agent SDK (separate business account)
HIGGSFIELD_API_KEY=             # [higgsfield.api_key]
HIGGSFIELD_API_SECRET=          # [higgsfield.api_secret]
FAL_KEY=                        # [fal.api_key] Kling AI Avatar talking reels
ELEVENLABS_API_KEY=             # [elevenlabs.api_key]
ZERNIO_API_KEY=                 # [zernio.api_key] publishing
LEMONSQUEEZY_API_KEY=           # [lemonsqueezy.api_key]
LEMONSQUEEZY_WEBHOOK_SECRET=    # [lemonsqueezy.webhook_secret]
RESEND_API_KEY=                 # [resend.api_key]
APIFY_TOKEN=                    # [apify.token]
PIXABAY_API_KEY=                # [pixabay.api_key]
DISCORD_BOT_TOKEN=              # [discord.bot_token] membership community
VOYAGE_API_KEY=                 # [voyage.api_key] optional embeddings (local model by default)

# ── Infra ──
VERCEL_TOKEN=                   # [vercel.token] for `ios secrets sync` (later)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # [supabase.service_role_key]
CRON_SECRET=                    # protects /api/cron/tick (Bearer token)

# ── Switches ──
IOS_FAKE_PROVIDERS=             # "1" = force every integration onto fakes, or a comma list of ids (e.g. "zernio,resend")
IOS_KEYCHAIN=                   # "off" = never read the macOS Keychain (env vars only)
