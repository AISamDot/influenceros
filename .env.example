# Troupe House environment. Copy to .env.local only if you need overrides; never commit real values.
# On the Mac, provider keys live in the Keychain (`pnpm troupe secrets set <name>`); env vars win when both exist.
# Any integration without a key runs on its deterministic fake.
# Studio switches are TROUPE_*; the old IOS_* names (Influencer OS, before the rename) are still read as a fallback.

# ── Database ──
# Unset = local PGlite under .data/pglite. Set = Postgres (Supabase), e.g. postgres://…:6543/postgres
DATABASE_URL=
DATABASE_POOL_MAX=
PGLITE_DIR=

# ── Providers (secret name in the Keychain in brackets) ──
ANTHROPIC_API_KEY=              # [anthropic.api_key] Claude Agent SDK (separate business account)
HIGGSFIELD_API_KEY=             # [higgsfield.api_key]
HIGGSFIELD_API_SECRET=          # [higgsfield.api_secret]
FAL_KEY=                        # [fal.api_key] Kling AI Avatar talking reels
ELEVENLABS_API_KEY=             # [elevenlabs.api_key]
ZERNIO_API_KEY=                 # [zernio.api_key] publishing
LEMONSQUEEZY_API_KEY=           # [lemonsqueezy.api_key]
LEMONSQUEEZY_WEBHOOK_SECRET=    # [lemonsqueezy.webhook_secret]
RESEND_API_KEY=                 # [resend.api_key]
ZERNIO_WEBHOOK_SECRET=          # [zernio.webhook_secret] optional; without it comments/DMs are polled
RESEND_WEBHOOK_SECRET=          # [resend.webhook_secret] optional (Svix signing secret for email events)
GOOGLE_SHEETS_TOKEN=            # [google.sheets_token] optional; Product Builder Sheets templates
NOTION_API_KEY=                 # [notion.api_key] optional; Product Builder Notion templates
NOTION_TEMPLATE_PARENT_ID=      # [notion.template_parent_id] Notion page the templates are created under
APIFY_TOKEN=                    # [apify.token]
PIXABAY_API_KEY=                # [pixabay.api_key]
DISCORD_BOT_TOKEN=              # [discord.bot_token] membership community
VOYAGE_API_KEY=                 # [voyage.api_key] optional embeddings (local model by default)

# ── Infra ──
VERCEL_TOKEN=                   # [vercel.token] for `troupe secrets sync` (later)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # [supabase.service_role_key]
CRON_SECRET=                    # protects /api/cron/tick (Bearer token)
TROUPE_STUDIO_DOMAIN=           # studio domain for persona sites: <slug>.<domain>; default troupehouse.com when deployed, unset locally (sites live at /p/<slug>); "off" = none

# ── Switches ──
TROUPE_FAKE_PROVIDERS=          # "1" = force every integration onto fakes, or a comma list of ids (e.g. "zernio,resend")
TROUPE_KEYCHAIN=                # "off" = never read the macOS Keychain (env vars only)

# ── IOS-2 (each stream adds its variables inside its own block; never real values) ──
# >>> stream A env
AUTH_SECRET=                    # signs the Owner session cookie (32+ random bytes); required when deployed
OWNER_EMAIL=                    # where magic links go (Resend); the only account that can sign in
AUTH_EMAIL_FROM=                # verified Resend sender for magic links
TROUPE_PUBLIC_URL=              # origin used in sign-in links when deployed (e.g. https://studio.example.com)
TROUPE_AUTH=                    # "off" = no sign-in, only on a loopback host and never when deployed (local dev)
TROUPE_AGENT_ENGINE=            # force one engine for live agent runs: "agent-sdk" or "messages" (default: SDK for tool runs)
TROUPE_LLM_FALLBACKS=           # "off" = no server-side refusal fallback on Sonnet/Opus calls
# <<< stream A env
# >>> stream B env
# (none) QC Q2 transcription reuses ELEVENLABS_API_KEY (Speech-to-Text); it goes live with the ElevenLabs integration.
# <<< stream B env
# >>> stream C env
TROUPE_FEED_ALLOWLIST=          # extra comma-separated hosts the News Desk may fetch (built-in allowlist otherwise)
TROUPE_EMBEDDINGS=              # "local" (default, no key) or "voyage" (needs VOYAGE_API_KEY)
TROUPE_PERSONAS_SOURCE=         # folder of launch-persona docs (<slug>/bible.md …) the importer reads; default packages/knowledge/seed/personas (empty since 16 Oct)
TROUPE_ARCHIVE_DIR=             # root of the persona archive (<YYYY-MM-DD>/<slug>/…); default packages/knowledge/seed/archive
TROUPE_PERSONAS_DIR=            # overrides where the seed reads launch personas (tests, other checkouts)
# <<< stream C env
# >>> stream D env
TROUPE_WORKER=                  # "inline" = run queue jobs inside the dev/start server (default without DATABASE_URL); "off" = never
TROUPE_TICKER=                  # "off" = no local tick (core tick + schedules every minute) in the server or `pnpm worker`
TROUPE_WORKER_CONCURRENCY=      # parallel claim loops for `pnpm worker` (default 2 on Postgres, 1 on PGlite)
# CRON_SECRET (Infra above) is required on Vercel: Vercel Cron sends it as a Bearer token to /api/cron/tick.
# <<< stream D env
# ── IOS-3/4 (each stream adds its variables inside its own block; never real values) ──
# >>> stream E env
TROUPE_MEDIA_DIR=               # where rendered media and product files are stored on the Mac (default .data/media)
HIGGSFIELD_CLI=                 # path to the official Higgsfield CLI if it isn't on PATH (installed with npm, never curl|sh)
HIGGSFIELD_MODELS=              # JSON overrides for model ids, e.g. {"talking":"seedance2_5"} (verify with `higgsfield model list --json`)
TROUPE_TALKING_PROVIDER=        # "fal" = talking clips via fal Kling AI Avatar v2 (FAL_KEY); default Higgsfield Seedance
TROUPE_VOICE_PROVIDER=          # "higgsfield" = Higgsfield TTS; default ElevenLabs
TROUPE_MEDIA_TOOLKIT=           # "ffmpeg" or "fake" to force the render toolkit (default: FFmpeg when Higgsfield is live)
TROUPE_FFMPEG=                  # FFmpeg/ffprobe binaries (default: the pinned ffmpeg-static / ffprobe-static builds)
TROUPE_FFPROBE=
# <<< stream E env
# >>> stream F env
# Zernio (publishing, comments, DMs, analytics). Keys live in the Keychain: pnpm troupe secrets set zernio.api_key
# (and optionally zernio.webhook_secret: without it webhooks are refused and the community worker polls).
# ZERNIO_API_KEY=
# ZERNIO_WEBHOOK_SECRET=
# Override the API base URL (default https://zernio.com/api/v1).
# ZERNIO_API_URL=
# <<< stream F env
# >>> stream G env
# TROUPE_STUDIO_DOMAIN (above): persona sites at https://<slug>.<domain> (wildcard DNS + TROUPE_ALLOWED_HOSTS); unset = /p/<slug> locally
# LEMONSQUEEZY_API_KEY / LEMONSQUEEZY_WEBHOOK_SECRET (both) switch the store live; webhooks → /api/webhooks/lemonsqueezy (X-Signature).
# RESEND_API_KEY switches lists live; RESEND_WEBHOOK_SECRET (whsec_…) enables /api/webhooks/resend (Svix).
# The physical-address footer and sender domain are set on /commerce (stored in the DB, not env).
# <<< stream G env
# >>> stream H env
# Product Builder (IOS-4 H). Headless Chrome renders product PDFs; auto-detected on the Mac (Chrome, Chromium, Edge, Brave).
# TROUPE_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Inbox for ready-written manuscripts (<dir>/<persona-slug>/*.md). Default: <repo>/.data/manuscripts
# TROUPE_MANUSCRIPTS_DIR=
# Force the fake PDF renderer outside tests (never ships: QP and the card still run).
# TROUPE_PRODUCTS_PDF=fake
# <<< stream H env
# ── IOS-5 (docs/IOS-5-CONTRACTS.md; each stream adds its variables inside its own block; never real values) ──
# >>> stream I env
# APIFY_TOKEN switches the Apify scrapers live (Keychain: pnpm troupe secrets set apify.token). Actor ids and prices live in
# the Radar config (radar_config), the weekly cap in studio settings (apify_weekly_cap_usd, set on /radar), not here.
# APIFY_TOKEN=
# <<< stream I env
# >>> stream J env
# PINTEREST_ACCESS_TOKEN switches Pinterest API v5 live (studio account; pending its key). Open-Meteo needs no key.
# TROUPE_PINTEREST_ACTOR overrides the Apify Pinterest scraper used when API search is unavailable (default silentflow/pinterest-scraper-ppr).
# <<< stream J env
# >>> stream K env
# <<< stream K env
# >>> stream L env
# <<< stream L env
