{
  "name": "troupe-house",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm db:setup && pnpm --filter @troupe/web dev",
    "build": "pnpm typecheck && pnpm --filter @troupe/web build",
    "start": "pnpm --filter @troupe/web start",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "tsx packages/db/src/cli/migrate.ts",
    "db:seed": "tsx packages/core/src/seed/cli.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed --if-empty",
    "db:reset": "tsx packages/db/src/cli/reset.ts && pnpm db:migrate && pnpm db:seed",
    "troupe": "tsx packages/secrets/src/cli.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "owner": "tsx packages/auth/src/cli.ts",
    "content": "tsx packages/content/src/cli.ts",
    "knowledge": "tsx packages/knowledge/src/cli.ts",
    "profit": "tsx packages/profit/src/cli.ts",
    "media": "tsx packages/media/src/cli.ts",
    "distribution": "tsx packages/distribution/src/cli.ts",
    "commerce": "tsx packages/commerce/src/cli.ts",
    "products": "tsx packages/products/src/cli.ts",
    "radar": "tsx packages/radar/src/cli.ts",
    "world": "tsx packages/world/src/cli.ts",
    "production": "tsx packages/production/src/cli.ts",
    "formats": "tsx packages/formats/src/cli.ts",
    "troupe:keys": "tsx scripts/secret-popup.ts",
    "ios": "tsx packages/secrets/src/cli.ts",
    "ios:keys": "tsx scripts/secret-popup.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
